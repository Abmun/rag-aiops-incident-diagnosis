# Copy to .env and fill in the values you need.
# .env is gitignored — never commit real secrets.
#
# Everything here is optional: scripts/generate_config.py falls back to
# local (offline) embeddings if OPENAI_API_KEY is unset, and every value
# below has a sensible default (see scripts/generate_config.py).

# ── LLM / Embeddings ─────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-ada-002
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# ── Redis (embedding cache) ──────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── App ────────────────────────────────────────────────────────
APP_ENV=development
API_PORT=8000
API_WORKERS=2
LOG_LEVEL=INFO
FORCE_REINDEX=false
